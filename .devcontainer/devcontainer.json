{
  // Codespacesのダッシュボードに表示される名前
  "name": "シンギュラリティ・ラボ AI駆動開発ハンズオン (Claude Code)",

  // ベース環境。Node.jsのLTS版とGitなどが最初から入っている公式イメージ
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",

  // 環境ができた直後に1回だけ実行されるコマンド。ここでClaude Codeをインストールする
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code",

  // VS Codeに自動で入れておく拡張機能
  "customizations": {
    "vscode": {
      "extensions": [
        // Microsoft製「Live Preview」。HTMLファイルをエディタ内ですぐプレビューできる
        "ms-vscode.live-server"
      ]
    }
  },

  // Webページのプレビューで使うポートを開けておく（Live Previewの既定は3000）
  "forwardPorts": [3000]
}